---
import FilterIsland from './GridCardsFilterIsland.jsx';

const API_URL = import.meta.env.PUBLIC_API_URL || 'https://catalogo-valkia.onrender.com';

// Precargamos los productos en el build para que el HTML llegue con el catálogo
// ya renderizado, sin depender de que Render esté despierto en cada visita.
// Reintentamos porque el primer hit puede fallar mientras Render sale del
// cold start. Si igual no responde, seguimos con [] y la isla completa en el
// cliente: el build nunca debe fallar por esto.
let initialProducts = [];
for (let intento = 1; intento <= 3; intento++) {
  try {
    const res = await fetch(`${API_URL}/api/products`, {
      signal: AbortSignal.timeout(60000), // tolera el cold start de Render
    });
    const json = await res.json();
    if (Array.isArray(json.data)) initialProducts = json.data;
    break;
  } catch (e) {
    console.warn(`[GridCards] Precarga de productos falló (intento ${intento}/3):`, e?.message);
    if (intento < 3) await new Promise((r) => setTimeout(r, 5000));
  }
}
---

<section id="catalogo" class="py-12 bg-primary-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-primary-900 mb-4">
        Colección Femenina
      </h2>
      <p class="text-lg text-primary-600 max-w-2xl mx-auto">
        Descubre nuestra exclusiva selección de indumentaria femenina,
        diseñada para la mujer moderna y elegante.
      </p>
    </div>

    <FilterIsland client:load initialProducts={initialProducts} />
  </div>
</section>
