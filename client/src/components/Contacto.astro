---
interface Props {
  whatsappNumber?: string;
  businessName?: string;
  message?: string;
}

const { 
  whatsappNumber = "3417565215", 
  businessName = "Valkia Indumentaria",
  message = "¡Hola! Me interesa conocer más sobre sus productos🤍"
} = Astro.props;

const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
---

<section id="contacto" class="relative bg-gradient-to-br from-primary-50 via-white to-gray-50 py-20 overflow-hidden">
  <div class="max-w-6xl mx-auto px-6">
    <div class="relative z-10">
      <!-- Header -->
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-800 mb-4 bg-gradient-to-r from-primary-600 to-primary-800 bg-clip-text">
          ¿Te gustó lo que viste?
        </h2>
        <p class="text-xl text-gray-600 font-normal leading-relaxed">
          Conversemos y encontremos tu look perfecto
        </p>
      </div>

      <!-- Main Content -->
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <!-- Info Card -->
        <div class="bg-white/90 backdrop-blur-xl rounded-3xl p-10 shadow-xl border border-white/20 transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl">
          <div class="flex items-center gap-4 mb-8">
            <div class="w-12 h-12 bg-gradient-to-br from-orange-200 to-orange-300 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none">
                <path d="M19 7h-3V6a4 4 0 0 0-8 0v1H5a1 1 0 0 0-1 1v11a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V8a1 1 0 0 0-1-1zM10 6a2 2 0 0 1 4 0v1h-4V6zm8 13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V9h2v1a1 1 0 0 0 2 0V9h4v1a1 1 0 0 0 2 0V9h2v10z" fill="currentColor"/>
              </svg>
            </div>
            <h3 class="text-2xl font-semibold text-gray-800">{businessName}</h3>
          </div>
          
          <div class="space-y-4">
            <div class="flex justify-between items-center py-4 border-b border-primary-100">
              <span class="font-medium text-gray-600 text-sm">Horarios de atención:</span>
              <span class="font-semibold text-gray-800 text-sm">Lun a Vie: 10:00 - 19:00</span>
            </div>
            <div class="flex justify-between items-center py-4 border-b border-primary-100">
              <span class="font-medium text-gray-600 text-sm">Sábados:</span>
              <span class="font-semibold text-gray-800 text-sm">10:00 - 18:00</span>
            </div>
            <div class="flex justify-between items-center py-4">
              <span class="font-medium text-gray-600 text-sm">Respuesta promedio:</span>
              <span class="font-semibold text-gray-800 text-sm">En menos de 1 hora</span>
            </div>
          </div>
        </div>

        <!-- WhatsApp CTA -->
        <div class="flex flex-col gap-4">
          <a 
            href={whatsappUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="group inline-flex items-center gap-3 bg-gradient-to-r from-whatsapp-500 to-whatsapp-600 text-white rounded-full px-6 py-3 shadow-md shadow-whatsapp-500/20 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-whatsapp-500/30 border border-white/20"
          >
            <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24" fill="none">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.570-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893A11.821 11.821 0 0020.864 3.687" fill="currentColor"/>
            </svg>
            <span class="font-medium text-sm">Escribinos por WhatsApp</span>
          </a>
          
          <p class="text-sm text-gray-600 text-center leading-relaxed">
            Recibí asesoramiento personalizado.
          </p>
        </div>
      </div>

      <!-- Decorative Elements -->
      <div class="absolute inset-0 pointer-events-none overflow-hidden">
        <div class="absolute w-48 h-48 bg-gradient-to-br from-primary-500/5 to-primary-700/3 rounded-full top-[10%] right-[10%] animate-float"></div>
        <div class="absolute w-36 h-36 bg-gradient-to-br from-primary-500/5 to-primary-700/3 rounded-full bottom-[20%] left-[5%] animate-float" style="animation-delay: 2s;"></div>
        <div class="absolute w-24 h-24 bg-gradient-to-br from-primary-500/5 to-primary-700/3 rounded-full top-[60%] right-[20%] animate-float" style="animation-delay: 4s;"></div>
      </div>
    </div>
  </div>
</section>