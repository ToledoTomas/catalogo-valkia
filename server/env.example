# Configuración de la base de datos
DATABASE_URL="postgresql://username:password@localhost:5432/catalogo_valkia"

# Configuración del servidor
PORT=3001
NODE_ENV=development

# Configuración de JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Configuración de CORS (opcional)
CORS_ORIGIN=http://localhost:4321

# Deploy Hook de Vercel: al cambiar productos/categorías, el server postea acá
# para rebuildeaer el frontend estático (que incrusta los productos en build).
# Se crea en Vercel → Project Settings → Git → Deploy Hooks. Dejar vacío en local.
DEPLOY_HOOK_URL=